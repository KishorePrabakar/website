{
  "rewrites": [
    {
      "source": "/neo/(.*)",
      "destination": "/neo/index.html"
    },
    {
      "source": "/conquer",
      "destination": "/conquer.html"
    },
    {
      "source": "/conquer/(.*)",
      "destination": "/conquer.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
